<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>PrankAndField.UI</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Shared Blazor UI for Prank &amp; Field: the game canvas component, JS canvas backend, Web Audio synth and interop glue.</Description>
    <StaticWebAssetBasePath>_content/PrankAndField.UI</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrankAndField.Core\PrankAndField.Core.csproj" />
    <ProjectReference Include="..\PrankAndField.Engine\PrankAndField.Engine.csproj" />
    <ProjectReference Include="..\PrankAndField.Audio\PrankAndField.Audio.csproj" />
  </ItemGroup>

</Project>
